# DAY 12 — Derivatives, Gradients & Probability
# ============================================================

print("\n========== DAY 12 ==========")

# Derivative of f(x) = x^2
x = 5

derivative = 2 * x

print("Derivative of x² at x = 5:", derivative)

# Numerical Derivative
def f(x):
    return x ** 2

h = 0.0001

numerical_derivative = (f(x + h) - f(x)) / h

print("Numerical Derivative:", numerical_derivative)

# Gradient of f(x, y) = x² + y²
x = 3
y = 4

gradient = np.array([
    2 * x,
    2 * y
])

print("Gradient:", gradient)

# Probability
favorable_outcomes = 3
total_outcomes = 10

probability = favorable_outcomes / total_outcomes

print("Probability:", probability)


