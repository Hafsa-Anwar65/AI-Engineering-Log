# ============================================================
# DAY 9 — Broadcasting & Vectorization vs Loops
# ============================================================

print("\n========== DAY 9 ==========")

numbers = np.array([1, 2, 3, 4, 5])

# Vectorization
print("Original:", numbers)
print("Multiply by 2:", numbers * 2)
print("Add 10:", numbers + 10)
print("Square:", numbers ** 2)

# Broadcasting
matrix = np.array([
    [1, 2, 3],
    [4, 5, 6]
])

vector = np.array([10, 20, 30])

print("\nBroadcasting:")
print(matrix + vector)

# Loop comparison
result_loop = []

for num in numbers:
    result_loop.append(num * 2)

print("\nUsing Loop:", result_loop)
print("Using NumPy:", numbers * 2)


# ============================================================
# DAY 10 — Pandas: Filtering, GroupBy, Missing Values
# ============================================================

import pandas as pd

print("\n========== DAY 10 ==========")

data = {
    "Name": ["Ali", "Sara", "Ahmed", "Hafsa"],
    "Age": [20, 22, 21, 23],
    "Department": ["AI", "AI", "Web", "Web"],
    "Score": [85, 90, None, 95]
}

df = pd.DataFrame(data)

print("\nDataFrame:")
print(df)

# Filtering
print("\nStudents with Age > 21:")
print(df[df["Age"] > 21])

# Missing values
print("\nMissing Values:")
print(df.isnull().sum())

# Fill missing values
df["Score"] = df["Score"].fillna(0)

print("\nAfter Filling Missing Values:")
print(df)

# GroupBy
print("\nAverage Score by Department:")
print(df.groupby("Department")["Score"].mean())


