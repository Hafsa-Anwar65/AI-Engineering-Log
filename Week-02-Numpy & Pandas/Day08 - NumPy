# DAY 13 — MSE Loss Function & Gradient Descent
# ============================================================

print("\n========== DAY 13 ==========")

actual = np.array([10, 20, 30])
predicted = np.array([12, 18, 29])

# Mean Squared Error
mse = np.mean((actual - predicted) ** 2)

print("MSE:", mse)


# Gradient Descent
x = 10
learning_rate = 0.1

print("\nGradient Descent:")

for i in range(10):

    gradient = 2 * x

    x = x - learning_rate * gradient

    print("Step", i + 1, "| x =", x)


# ============================================================
# DAY 14 — PROJECT: Linear Regression from Scratch
# Predict Queue Wait Time
# ============================================================

print("\n========== DAY 14: PROJECT ==========")

# Training data
X = np.array([1, 2, 3, 4, 5])

# Wait time in minutes
y = np.array([5, 10, 15, 20, 25])

# Model parameters
m = 0
b = 0

learning_rate = 0.01
epochs = 1000

n = len(X)


# Training using Gradient Descent
for i in range(epochs):

    # Prediction
    y_pred = m * X + b

    # Error
    error = y_pred - y

    # Calculate gradients
    dm = (2 / n) * np.sum(X * error)
    db = (2 / n) * np.sum(error)

    # Update parameters
    m = m - learning_rate * dm
    b = b - learning_rate * db


print("Slope (m):", m)
print("Intercept (b):", b)


# Predict wait time
queue_length = 6

predicted_wait_time = m * queue_length + b

print("\nQueue Length:", queue_length)
print("Predicted Wait Time:", predicted_wait_time, "minutes")
